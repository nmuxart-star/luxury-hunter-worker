PORT=8200

# Existing Xianyu Hunter backend. Luxury Hunter uses it only as a live crawler connector.
# Keep your Xianyu Hunter running on this address during v1.1.
XIANYU_BASE_URL=http://127.0.0.1:8000
XIANYU_DB=$HOME/ai-goofish-monitor-wangdaguo/data/app.sqlite3
# Modo directo: sesiones independientes en este directorio. Nil.json sigue
# funcionando como cuenta principal y las demás se usan como reserva.
XIANYU_STATE_DIR=$HOME/ai-goofish-monitor-wangdaguo/state

# Single central AI engine for all sources.
# If OPENAI_API_KEY is set, OpenAI is used; otherwise Gemini (or force with AI_PROVIDER=openai|gemini).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_TRIAGE_MODEL=gpt-6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Google Lens (SerpApi) and Cloud Vision work with either AI provider.
GOOGLE_CLOUD_VISION_API_KEY=
SERPAPI_API_KEY=

# Cost control: cheap batch triage, then full analysis of the best N per task run.
AI_TRIAGE_MIN_SCORE=60
AI_MAX_ITEMS_PER_TASK_RUN=5

# Daily summary email (first run after this hour, Europe/Madrid). DIGEST_SCHEDULE=interval for the old 3h mode.
DIGEST_SCHEDULE=daily
DIGEST_DAILY_HOUR=9

# Search limits. Xianyu stays conservative because of marketplace risk controls.
XIANYU_MAX_QUERIES=1
BUNJANG_MAX_QUERIES=2
BUYEE_MAX_QUERIES=2

# Email summaries (generic SMTP)
# Gmail example: smtp.gmail.com / 465 / true + App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Public HTML viewer used by the "Abrir informe" email button.
REPORT_BASE_URL=https://nmuxart-star.github.io/luxury-hunter-worker/report.html
