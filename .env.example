PORT=8200

# Existing Xianyu Hunter backend. Luxury Hunter uses it only as a live crawler connector.
# Keep your Xianyu Hunter running on this address during v1.1.
XIANYU_BASE_URL=http://127.0.0.1:8000
XIANYU_DB=$HOME/ai-goofish-monitor-wangdaguo/data/app.sqlite3

# Single central AI engine for all sources.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Search limits. Xianyu stays conservative because of marketplace risk controls.
XIANYU_MAX_QUERIES=1
BUNJANG_MAX_QUERIES=2
BUYEE_MAX_QUERIES=2

# Email summaries (generic SMTP)
# Gmail example: smtp.gmail.com / 465 / true + App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
