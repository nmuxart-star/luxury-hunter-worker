{
  "manifest_version": 3,
  "name": "Luxury Hunter Mac local",
  "version": "0.6.0",
  "description": "Consulta subastas de One Map y busca en Vestiaire desde el Chrome del Mac para Luxury Hunter.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.fromjapan.co.jp/*",
    "https://es.vestiairecollective.com/*",
    "https://search.vestiairecollective.com/*",
    "http://127.0.0.1:8210/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "options.html"
}
